# FloatOS Plymouth theme - simple, high-contrast branded startup.
Window.SetBackgroundTopColor(0.025, 0.035, 0.025);
Window.SetBackgroundBottomColor(0.006, 0.009, 0.006);

title_image = Image.Text("FLOATOS", 0.68, 1.0, 0.30, 1.0, "Sans Bold 34", "center");
subtitle_image = Image.Text("A DESKTOP THAT FLOWS", 0.62, 0.70, 0.58, 1.0, "Sans 10", "center");
progress_image = Image.Text("Starting FloatOS", 0.72, 0.78, 0.66, 1.0, "Sans 11", "center");
accent_image = Image.Text("●   ●   ●", 0.65, 1.0, 0.30, 0.95, "Sans 13", "center");

title_sprite = Sprite(title_image);
subtitle_sprite = Sprite(subtitle_image);
progress_sprite = Sprite(progress_image);
accent_sprite = Sprite(accent_image);

fun centre_sprite(sprite, image, y)
{
    sprite.SetImage(image);
    sprite.SetX(Window.GetWidth() / 2 - image.GetWidth() / 2);
    sprite.SetY(y);
}

fun reposition()
{
    centre_sprite(accent_sprite, accent_image, Window.GetHeight() * 0.405);
    centre_sprite(title_sprite, title_image, Window.GetHeight() * 0.465);
    centre_sprite(subtitle_sprite, subtitle_image, Window.GetHeight() * 0.535);
    centre_sprite(progress_sprite, progress_image, Window.GetHeight() * 0.625);
}

reposition();

fun progress_callback(time, progress)
{
    percent = Math.Int(Math.Clamp(progress * 100, 0, 100));
    progress_image = Image.Text("Starting FloatOS  •  " + percent + "%", 0.72, 0.78, 0.66, 1.0, "Sans 11", "center");
    centre_sprite(progress_sprite, progress_image, Window.GetHeight() * 0.625);
}

fun status_callback(status)
{
    if (status != "")
    {
        progress_image = Image.Text(status, 0.72, 0.78, 0.66, 1.0, "Sans 11", "center");
        centre_sprite(progress_sprite, progress_image, Window.GetHeight() * 0.625);
    }
}

Plymouth.SetBootProgressFunction(progress_callback);
Plymouth.SetUpdateStatusFunction(status_callback);
