From 9bf5145eba45cd5e3b87d4f040618fe0ea69a81d Mon Sep 17 00:00:00 2001
From: FloatOS maintainers <maintainers@floatos.local>
Date: Sun, 15 Nov 2026 20:00:00 +0530
Subject: [PATCH] pcmanfm: fix GCC 14 incompatible pointer returns

GCC 14 diagnoses these implicit pointer conversions as errors. Cast the
referenced desktop item to its declared AtkObject return type.

---
 src/desktop.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/desktop.c b/src/desktop.c
--- a/src/desktop.c
+++ b/src/desktop.c
@@ -1270,7 +1270,7 @@ static AtkObject *fm_desktop_accessible_ref_selection(AtkSelection *selection,
-                return g_object_ref(item);
+                return (AtkObject *)g_object_ref(item);
@@ -1457,7 +1457,7 @@ static AtkObject *fm_desktop_accessible_ref_child(AtkObject *accessible,
-    return g_object_ref(item);
+    return (AtkObject *)g_object_ref(item);
-- 
2.46.0
